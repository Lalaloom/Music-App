<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Dark-only in Milestone 1.
         Compose manages all visual theming via DadMusicTheme (Material 3).
         The XML theme only sets the window/status bar colours during launch. -->
    <style name="Theme.DadMusicApp" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
